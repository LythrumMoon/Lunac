{
  "name": "claude-code-gui",
  "version": "1.0.0",
  "description": "Claude Code GUI - Native Desktop Client (Tauri)",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
