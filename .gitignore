# ══════════════════════════════════════════════════════════════
# Lunac .gitignore
# ══════════════════════════════════════════════════════════════

# ── 密钥 / 环境变量（绝不入库）─────────────────────────────────
# 注意：一旦提交过，即使后续删除，密钥仍留在 commit 历史里，必须换新密钥。
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# ── 依赖 ──────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ── 构建产物 ──────────────────────────────────────────────────
app/dist/
ui/dist/
# 磁盘插件（Modules\<id>\）的独立构建产物 —— 见 app/vite.plugins.config.ts + scripts/build-plugins.ps1
app/plugin-dist/
app/src-tauri/target/
app/src-tauri/target-e2e/
app/src-tauri/gen/
# 自研 agent 核心（core-agent）的编译产物
core-agent/target/
# 调音插件的 DSP 引擎内核（tuning-engine）的编译产物
tuning-engine/target/
# Tauri 侧随附的二进制（历史遗留目录）
app/src-tauri/binaries/
# VS Code 扩展的编译输出（源在 vscode-extension/src/）
vscode-extension/out/

# ── 参考资料（不随本仓库分发）──────────────────────────────────
# _reference/ = 学习 / 参考用的第三方源码，**整目录忽略** —— 参考材料不进发行链路。
#   目前只有 core/（Claude Code CLI 上游源码 + cli.exe；Anthropic 版权，禁止再分发）。
#   2026-10-06 从仓库根 `core/` 归到这里（分类：⑧ 参考学习目录）。
_reference/
# 双保险：任何层级的 core/ 都不许入库（上游 CLI 那份曾经就在仓库根）
core/
# 离线 OCR 引擎与模型（体积大）→ 已不随安装包分发：装 `ocr` 插件时由宿主下到
# <exe 根>\Modules\ocr\paddle-ocr\（见 ai-spec §3.5）。仓库根这一份只给 dev 用
# （scripts/download-paddle-ocr.ps1 会拉到这儿）。
paddle-ocr/
# 本地 gcc 工具链
mingw64/
# 本地模型
local-models/

# ── 发布产物 ──────────────────────────────────────────────────
release/
*.vsix

# ── 调试残留 ──────────────────────────────────────────────────
.tmp-zoom-test/
_t_in.txt
_t_out.txt
_t_err.txt
testapi.txt
*.log

# ── 编辑器 / 系统 ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
